{
  "version": 1,
  "stack": "typescript",
  "paths": {
    "source": [
      "src/**/*.ts"
    ],
    "shared": [],
    "unit_tests": [
      "tests/unit/**/*.test.ts"
    ],
    "bdd_features": [
      "features/**/*.feature"
    ],
    "bdd_steps": [
      "features/steps/**/*.ts",
      "features/support/**/*.ts"
    ],
    "docs": [
      "README.md",
      "docs/METHODOLOGY.md",
      "docs/bootstrap-log.md"
    ],
    "spec": "SPEC.md",
    "design": [
      "SPEC.md",
      "DOMAIN.md",
      "DECISIONS.md"
    ],
    "progress": "progress.json"
  },
  "commands": {
    "bdd": "npm run build && NODE_OPTIONS=\"--import tsx\" npx cucumber-js",
    "unit": "npx vitest run",
    "typecheck": "npx tsc --noEmit",
    "format": null,
    "lint": null,
    "coverage": null,
    "extra_checks": []
  },
  "refactor": {
    "entry": [
      "src/cli.ts"
    ]
  }
}
